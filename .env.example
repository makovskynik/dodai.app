# Copy to .env.local

# Neon Postgres (optional until connected)
DATABASE_URL=

# Auth
AUTH_SECRET=replace-with-long-random-string
ADMIN_EMAILS=admin@dodai.app
APP_URL=http://localhost:3000

# Payments: local | monobank | wayforpay
PAYMENT_PROVIDER=local
MONOBANK_TOKEN=
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_MERCHANT_SECRET=
WAYFORPAY_MERCHANT_DOMAIN=

# Email (optional — without Resend, magic links are logged / shown in dev)
RESEND_API_KEY=
EMAIL_FROM=noreply@dodai.app

# Analytics (optional — without key, events log to console in dev)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Cloudflare Turnstile (optional — without keys, anonymous votes work in local/dev)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
